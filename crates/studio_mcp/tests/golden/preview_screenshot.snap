{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "What the preview shows: a PNG at most `max_size` pixels on its longest side (default 800), or with `format: \"outline\"` its items as text, one per line.",
  "inputSchema": {
    "properties": {
      "format": {
        "description": "`png` (default) or `outline`: one text line per item.",
        "enum": [
          "png",
          "outline"
        ],
        "type": "string"
      },
      "max_size": {
        "description": "Longest side of a PNG in pixels (default 800, at most 1280).",
        "type": "integer"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_screenshot",
  "outputSchema": {
    "properties": {
      "bytes": {},
      "height": {},
      "outline": {},
      "width": {}
    },
    "type": "object"
  },
  "required_cap": "inspect"
}
