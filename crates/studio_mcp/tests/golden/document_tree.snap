---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "A document's objects in order: handle, path, type, id, bindings. Grouped properties (`font.bold`) are bindings. Paginated by `cursor`.",
  "inputSchema": {
    "properties": {
      "cursor": {
        "description": "From a previous page's `next`.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "limit": {
        "description": "At most this many objects (default 200).",
        "type": "integer"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "document_tree",
  "outputSchema": {
    "properties": {
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "next": {},
      "nodes": {
        "type": "array"
      }
    },
    "required": [
      "doc",
      "generation",
      "nodes"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
