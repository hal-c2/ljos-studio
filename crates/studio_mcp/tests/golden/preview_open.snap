---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Run a document (a shell) in a preview for a target (desktop, tablet, phone) with live blocks or the mock modules. On the open preview it changes size or state in place; `state_kept` says whether the app's state survived.",
  "inputSchema": {
    "properties": {
      "doc": {
        "description": "The document to run, usually a shell (`Shell.qml`).",
        "type": "string"
      },
      "size": {
        "description": "A size in logical pixels instead of a target's.",
        "properties": {
          "height": {
            "maximum": 8192,
            "type": "integer"
          },
          "width": {
            "maximum": 8192,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "state": {
        "description": "`live` runs the app's blocks; `mocked` the mock modules (`mocks/`) in their place. Default: the open preview's, else `live`.",
        "enum": [
          "live",
          "mocked"
        ],
        "type": "string"
      },
      "target": {
        "description": "The screen to lay it out for (default: the open preview's, else `desktop`).",
        "enum": [
          "desktop",
          "tablet",
          "phone"
        ],
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_open",
  "outputSchema": {
    "properties": {
      "doc": {
        "type": "string"
      },
      "mocked": {
        "type": "array"
      },
      "ms": {
        "type": "number"
      },
      "size": {},
      "started": {
        "type": "boolean"
      },
      "state": {},
      "state_kept": {
        "type": "boolean"
      },
      "target": {}
    },
    "required": [
      "doc",
      "size",
      "state",
      "mocked",
      "started",
      "state_kept",
      "ms"
    ],
    "type": "object"
  },
  "required_cap": "run"
}
