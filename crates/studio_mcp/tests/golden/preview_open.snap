---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Run a document (a shell) in a preview for a target (desktop, tablet, phone) with live blocks or the project's mock modules. On the open preview it changes size or state in place, keeping the app's state. Edits show in it at once.",
  "inputSchema": {
    "$defs": {
      "Size": {
        "properties": {
          "height": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "State": {
        "description": "Whether the blocks are the app's own or its mock modules'.",
        "enum": [
          "live",
          "mocked"
        ],
        "type": "string"
      },
      "Target": {
        "description": "The shape of screen a preview is laid out for.",
        "enum": [
          "desktop",
          "tablet",
          "phone"
        ],
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document to run, usually a shell (`Shell.qml`).",
        "type": "string"
      },
      "size": {
        "anyOf": [
          {
            "$ref": "#/$defs/Size"
          },
          {
            "type": "null"
          }
        ],
        "description": "A size in logical pixels instead of a target's."
      },
      "state": {
        "anyOf": [
          {
            "$ref": "#/$defs/State"
          },
          {
            "type": "null"
          }
        ],
        "description": "`live` runs the app's own blocks; `mocked` the project's mock\nmodules (`mocks/`) in their place. Default: the open preview's, else\n`live`."
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/$defs/Target"
          },
          {
            "type": "null"
          }
        ],
        "description": "The screen to lay it out for (default: the open preview's, else\n`desktop`)."
      }
    },
    "required": [
      "doc"
    ],
    "title": "OpenArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_open",
  "outputSchema": {
    "$defs": {
      "Size": {
        "properties": {
          "height": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "State": {
        "description": "Whether the blocks are the app's own or its mock modules'.",
        "enum": [
          "live",
          "mocked"
        ],
        "type": "string"
      },
      "Target": {
        "description": "The shape of screen a preview is laid out for.",
        "enum": [
          "desktop",
          "tablet",
          "phone"
        ],
        "type": "string"
      }
    },
    "properties": {
      "doc": {
        "type": "string"
      },
      "mocked": {
        "description": "The modules mock modules stand in for.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "ms": {
        "format": "double",
        "type": "number"
      },
      "size": {
        "$ref": "#/$defs/Size"
      },
      "started": {
        "description": "A new process was started; false when the open one was changed.",
        "type": "boolean"
      },
      "state": {
        "$ref": "#/$defs/State"
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/$defs/Target"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "doc",
      "size",
      "state",
      "mocked",
      "started",
      "ms"
    ],
    "title": "OpenOut",
    "type": "object"
  },
  "required_cap": "run"
}
