expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Find objects by id, type, binding name or text in a binding's value, in one document or all (naming those it could not parse or read). Returns handles.",
  "inputSchema": {
    "properties": {
      "binding": {
        "description": "Has a binding of this name (`font.bold`).",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "description": "One document; every one that parses when left out.",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "description": "Some binding's value contains this text.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_find",
  "outputSchema": {
    "properties": {
      "broken": {
        "type": "array"
      },
      "nodes": {
        "type": "array"
      },
      "unreadable": {
        "type": "array"
      }
    },
    "required": [
      "nodes",
      "broken",
      "unreadable"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
