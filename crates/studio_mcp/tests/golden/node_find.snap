{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Find objects by id, type, binding name or text in a binding's value, in one document or all. Returns handles.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "binding": {
        "description": "Has a binding of this name (`font.bold`).",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "description": "One document; every one that parses when left out.",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "description": "Some binding's value contains this text.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "FindArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_find",
  "outputSchema": {
    "$defs": {
      "Found": {
        "properties": {
          "doc": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "doc",
          "node",
          "path",
          "type"
        ],
        "type": "object"
      }
    },
    "properties": {
      "broken": {
        "description": "Documents left out because they do not parse.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "nodes": {
        "items": {
          "$ref": "#/$defs/Found"
        },
        "type": "array"
      }
    },
    "required": [
      "nodes",
      "broken"
    ],
    "title": "FindOut",
    "type": "object"
  },
  "required_cap": "inspect"
}
