---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Create a QML document from `text`, or from a JSON file's records (`data`). Refused if it exists or does not parse. `block` declares it in the `qmldir` beside it. Undo removes it.",
  "inputSchema": {
    "properties": {
      "block": {
        "description": "Also declare it a functional block in the `qmldir` beside it.",
        "type": "boolean"
      },
      "data": {
        "description": "A project JSON file of records: a `JsonListModel` of it, or with `model: \"list\"` a `ListModel` copy. Not with `text`.",
        "type": "string"
      },
      "doc": {
        "description": "A new `.qml` path relative to the project.",
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "model": {
        "description": "How `data` is kept: `json` (the default), or `list`.",
        "enum": [
          "json",
          "list"
        ],
        "type": "string"
      },
      "text": {
        "description": "Its text; an empty `Item` importing QtQuick when left out.",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "document_new",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
