---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Create a QML document from `text`, a JSON file's records (`data`) or a block's `shell`. Refused if it exists or does not parse. Undo removes it.",
  "inputSchema": {
    "properties": {
      "block": {
        "description": "Also declare it a functional block in the `qmldir` beside it.",
        "type": "boolean"
      },
      "data": {
        "description": "A project JSON file of records. Not with `text`.",
        "type": "string"
      },
      "doc": {
        "description": "A new `.qml` path relative to the project.",
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "model": {
        "description": "`json` (default): a `JsonListModel` of it; `list`: a `ListModel` copy.",
        "enum": [
          "json",
          "list"
        ],
        "type": "string"
      },
      "shell": {
        "description": "Skin `Module.Name`'s slots.",
        "type": "string"
      },
      "text": {
        "description": "Its text; default an empty QtQuick `Item`.",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "document_new",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "id": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
