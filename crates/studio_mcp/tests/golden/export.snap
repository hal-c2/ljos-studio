---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a bundle of the project that runs without Studio: its QML, theme, assets and own modules, never mocks or `.studio/`. `native`: `ljos-bundle.json` says how `ljos run` starts it. `web`: `ljos-site.json` says what ljos-web builds a site from. `dry_run` writes nothing.",
  "inputSchema": {
    "$defs": {
      "Target": {
        "oneOf": [
          {
            "const": "native",
            "description": "A directory `ljos run` starts.",
            "type": "string"
          },
          {
            "const": "web",
            "description": "A directory ljos-web builds a static site from.",
            "type": "string"
          }
        ]
      }
    },
    "additionalProperties": false,
    "properties": {
      "dry_run": {
        "default": false,
        "description": "Say what the bundle would hold; write nothing.",
        "type": "boolean"
      },
      "entry": {
        "description": "The document the app starts with, usually its shell (`Shell.qml`).",
        "type": "string"
      },
      "out": {
        "description": "Where, relative to the project and below its `build/`; default\n`build/<target>`. A previous bundle there is replaced.",
        "type": [
          "string",
          "null"
        ]
      },
      "target": {
        "$ref": "#/$defs/Target",
        "default": "native",
        "description": "`native` (default) or `web`."
      }
    },
    "required": [
      "entry"
    ],
    "title": "ExportArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "export",
  "outputSchema": {
    "$defs": {
      "BlockFile": {
        "properties": {
          "block": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "block",
          "file"
        ],
        "type": "object"
      },
      "FileEntry": {
        "properties": {
          "bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes"
        ],
        "type": "object"
      },
      "LeftOut": {
        "properties": {
          "path": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "why"
        ],
        "type": "object"
      },
      "LinkEntry": {
        "properties": {
          "path": {
            "description": "Where the link is, relative to the bundle.",
            "type": "string"
          },
          "to": {
            "description": "The directory it leads to, relative to the bundle.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "to"
        ],
        "type": "object"
      },
      "Manifest": {
        "description": "What a bundle holds; written beside it as `ljos-bundle.json`, or for\nthe web as `ljos-site.json`.",
        "properties": {
          "blocks": {
            "description": "The project's own blocks, as `Module.Name`, and their files.",
            "items": {
              "$ref": "#/$defs/BlockFile"
            },
            "type": "array"
          },
          "entry": {
            "type": "string"
          },
          "files": {
            "description": "Every file, by path relative to the bundle.",
            "items": {
              "$ref": "#/$defs/FileEntry"
            },
            "type": "array"
          },
          "format": {
            "type": "string"
          },
          "imports": {
            "description": "The modules the site imports that are not the project's, sorted:\nwhat the builder takes from ljos-web (web).",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "left_out": {
            "description": "What of the project is not in the bundle, and why.",
            "items": {
              "$ref": "#/$defs/LeftOut"
            },
            "type": "array"
          },
          "links": {
            "description": "Links to directories the bundle holds, so what the app reads\nthrough a link's name is there too: written as links where the\nsystem makes them, and where it does not as a copy of the\ndirectory under the link's name.",
            "items": {
              "$ref": "#/$defs/LinkEntry"
            },
            "type": "array"
          },
          "ljos_web": {
            "description": "The ljos-web commit the imports were checked against (web).",
            "type": [
              "string",
              "null"
            ]
          },
          "modules": {
            "description": "The project's own modules and their `qmldir`s (web).",
            "items": {
              "$ref": "#/$defs/ModuleDir"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "run": {
            "description": "The command that starts it, run in the bundle's directory (native).",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "target": {
            "$ref": "#/$defs/Target"
          },
          "theme": {
            "description": "The theme file the app reads: the nearest `theme.json` from its\nentry's directory up to the project's.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "format",
          "version",
          "target",
          "entry",
          "blocks",
          "files",
          "left_out"
        ],
        "type": "object"
      },
      "ModuleDir": {
        "properties": {
          "module": {
            "type": "string"
          },
          "qmldir": {
            "type": "string"
          }
        },
        "required": [
          "module",
          "qmldir"
        ],
        "type": "object"
      },
      "Target": {
        "oneOf": [
          {
            "const": "native",
            "description": "A directory `ljos run` starts.",
            "type": "string"
          },
          {
            "const": "web",
            "description": "A directory ljos-web builds a static site from.",
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "bytes": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "files": {
        "description": "How many files the bundle holds and their size, which stay true when\na long manifest is cut short in this answer (the one written is whole),\ncopies of links it could not hold as links included.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "manifest": {
        "$ref": "#/$defs/Manifest"
      },
      "ms": {
        "format": "double",
        "type": "number"
      },
      "out": {
        "description": "The bundle's directory, relative to the project.",
        "type": "string"
      },
      "written": {
        "description": "False for a dry run.",
        "type": "boolean"
      }
    },
    "required": [
      "out",
      "files",
      "bytes",
      "manifest",
      "written",
      "ms"
    ],
    "title": "ExportOut",
    "type": "object"
  },
  "required_cap": "fs"
}
