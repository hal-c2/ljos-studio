---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a bundle that runs without Studio: QML, theme, assets and own modules, never mocks or `.studio/`. `native`: `ljos-bundle.json` says how `ljos run` starts it. `web`: `ljos-site.json` is what ljos-web builds from. `dry_run` writes nothing.",
  "inputSchema": {
    "properties": {
      "dry_run": {
        "description": "Say what the bundle would hold; write nothing.",
        "type": "boolean"
      },
      "entry": {
        "description": "The document the app starts with, usually its shell (`Shell.qml`).",
        "type": "string"
      },
      "out": {
        "description": "Below the project's `build/`; default `build/<target>`. A bundle there is replaced.",
        "type": "string"
      },
      "target": {
        "default": "native",
        "description": "`native` (default) or `web`.",
        "enum": [
          "native",
          "web"
        ],
        "type": "string"
      }
    },
    "required": [
      "entry"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "export",
  "outputSchema": {
    "properties": {
      "bytes": {
        "type": "integer"
      },
      "files": {
        "type": "integer"
      },
      "manifest": {},
      "ms": {
        "type": "number"
      },
      "out": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "replaces": {
        "type": "boolean"
      },
      "written": {
        "type": "boolean"
      }
    },
    "required": [
      "out",
      "path",
      "files",
      "bytes",
      "manifest",
      "written",
      "replaces",
      "ms"
    ],
    "type": "object"
  },
  "required_cap": "fs"
}
