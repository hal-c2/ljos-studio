---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a bundle that runs without Studio: QML, theme, assets, own modules; no mocks or `.studio/`. `native`: `ljos run` starts it from `ljos-bundle.json`. `web`: ljos-web builds from `ljos-site.json`, here with `build` (needs `run`). `dry_run`: what it would hold; writes nothing.",
  "inputSchema": {
    "properties": {
      "build": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "entry": {
        "description": "The document the app starts with, usually `Shell.qml`.",
        "type": "string"
      },
      "ljos_web": {
        "type": "string"
      },
      "open": {
        "type": "boolean"
      },
      "out": {
        "description": "Below `build/`, default `build/<target>`; replaced.",
        "type": "string"
      },
      "page": {
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "qmlc": {
        "type": "string"
      },
      "target": {
        "default": "native",
        "enum": [
          "native",
          "web"
        ],
        "type": "string"
      }
    },
    "required": [
      "entry"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "export",
  "outputSchema": {
    "properties": {
      "build": {},
      "bytes": {
        "type": "integer"
      },
      "files": {
        "type": "integer"
      },
      "manifest": {},
      "ms": {
        "type": "number"
      },
      "out": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "replaces": {
        "type": "boolean"
      },
      "writes": {
        "type": "integer"
      },
      "written": {
        "type": "boolean"
      }
    },
    "required": [
      "out",
      "path",
      "files",
      "bytes",
      "writes",
      "manifest",
      "written",
      "replaces",
      "ms"
    ],
    "type": "object"
  },
  "required_cap": "fs"
}
