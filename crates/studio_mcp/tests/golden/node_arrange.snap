---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "A canvas gesture, one undo step. `geometry`: boxes, drag rules, siblings. `place`: x/y/size, writing what governs each object. `align`, `copy`, `paste`, `duplicate`, `remove`, `rename`. `hide`, `show`, `lock`, `unlock` leave the file alone.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      }
    },
    "properties": {
      "action": {
        "enum": [
          "geometry",
          "place",
          "align",
          "copy",
          "paste",
          "duplicate",
          "remove",
          "rename",
          "hide",
          "show",
          "lock",
          "unlock"
        ],
        "type": "string"
      },
      "align": {
        "description": "For `align`; one object lines up with its parent.",
        "enum": [
          "left",
          "hcenter",
          "right",
          "top",
          "vcenter",
          "bottom",
          "distribute_h",
          "distribute_v"
        ],
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "For a `path`.",
        "type": "integer"
      },
      "name": {
        "description": "For `rename`: the object's new `id`.",
        "type": "string"
      },
      "nodes": {
        "description": "For all but `place` and `paste`.",
        "items": {
          "$ref": "#/$defs/Address"
        },
        "type": "array"
      },
      "parent": {
        "$ref": "#/$defs/Address",
        "description": "For `paste`, into any document. Ids it has are renamed."
      },
      "places": {
        "description": "For `place`.",
        "items": {
          "properties": {
            "height": {
              "type": "number"
            },
            "node": {
              "$ref": "#/$defs/Address"
            },
            "width": {
              "type": "number"
            },
            "x": {
              "description": "In the parent's coordinates. What is left out stays.",
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "node"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "record": {
        "description": "For `place` and `align`: write into this state, not the object.",
        "properties": {
          "on": {
            "$ref": "#/$defs/Address"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "on"
        ],
        "type": "object"
      },
      "within": {
        "description": "For `geometry`: the siblings are the first node's children, for something drawn inside it.",
        "type": "boolean"
      },
      "without_siblings": {
        "description": "For `geometry`: leave the siblings out (each is a read of the running app).",
        "type": "boolean"
      }
    },
    "required": [
      "action",
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_arrange",
  "outputSchema": {
    "properties": {
      "boxes": {},
      "changes": {},
      "copied": {},
      "doc": {},
      "generation": {},
      "history": {},
      "node": {},
      "nodes": {},
      "parent": {},
      "rebased_from": {},
      "siblings": {},
      "text": {},
      "unchanged": {}
    },
    "type": "object"
  },
  "required_cap": "inspect"
}
