---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Set a binding expression or a signal handler, or remove it with null. Refused with `would_break` if the file would not parse.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; refused if the document moved on. Needed when\nan address is a `path`, which is true of one generation only.",
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "description": "A property (`width`) or a handler (`onClicked`).",
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address"
      },
      "value": {
        "description": "QML after the `:` (`parent.width / 2`, `{ count++ }`); `null` removes it.\nRequired: left out, nothing is removed.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc",
      "node",
      "name",
      "value"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "binding_set",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
