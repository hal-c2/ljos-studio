---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Set a binding expression or a signal handler, or remove it with null. Refused with `would_break` if the file would not parse.",
  "inputSchema": {
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; a `path` needs it (handles and ids are moved past others' edits).",
        "type": "integer"
      },
      "name": {
        "description": "A property (`width`) or a handler (`onClicked`).",
        "type": "string"
      },
      "node": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      },
      "value": {
        "description": "QML after the `:` (`parent.width / 2`, `{ count++ }`); `null` removes it. Required.",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "node",
      "name",
      "value"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "binding_set",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
