---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Set a binding expression or a signal handler, or remove it with null. Refused with `would_break` if the file would not parse.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "How a caller names an object.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "A handle the session gave out (`n7`); stable for the session.",
            "properties": {
              "node": {
                "type": "string"
              }
            },
            "required": [
              "node"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The object's `id` in the document.",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A path as `document_tree` prints it (`root/0/contentItem:`), true of\nthe current text only.",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          }
        ]
      }
    },
    "additionalProperties": false,
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "description": "A property (`width`) or a handler (`onClicked`).",
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address"
      },
      "value": {
        "description": "QML after the `:` (`parent.width / 2`, `{ count++ }`); `null` removes it.\nRequired: left out, nothing is removed.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc",
      "node",
      "name",
      "value"
    ],
    "title": "BindingArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "binding_set",
  "outputSchema": {
    "$defs": {
      "ChangeOut": {
        "properties": {
          "end": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "description": "Byte range of the text before the edit.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "type": "object"
      }
    },
    "properties": {
      "changes": {
        "items": {
          "$ref": "#/$defs/ChangeOut"
        },
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "description": "The document's generation now; pass it with the next edit.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "history": {
        "description": "The history entry; absent for a dry run or an unchanged document.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "description": "The handle of the object put or moved.",
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "description": "The text the edit would give, for a dry run.",
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "description": "The document already said this: nothing was written and no history\nentry made.",
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "title": "EditOut",
    "type": "object"
  },
  "required_cap": "mutate"
}
