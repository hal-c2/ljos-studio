---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Read an object in the preview: its QML state (`variant`) and a block's published state, which `set` assigns when the block is mocked. `click` or `click_at` clicks first, as a person does, so a flow plays. Objects are found by `id`.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "How a caller names an object.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "A handle the session gave out (`n7`); stable for the session.",
            "properties": {
              "node": {
                "type": "string"
              }
            },
            "required": [
              "node"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The object's `id` in the document.",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A path as `document_tree` prints it (`root/0/contentItem:`), true of\nthe current text only.",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          }
        ]
      },
      "ClickAt": {
        "additionalProperties": false,
        "properties": {
          "x": {
            "description": "The preview's logical pixels.",
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "click": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "An object (with an `id`) to click first, after `set`, as a person\ndoes: the app's own handlers answer, so a flow plays."
      },
      "click_at": {
        "anyOf": [
          {
            "$ref": "#/$defs/ClickAt"
          },
          {
            "type": "null"
          }
        ],
        "description": "A point to click instead: the topmost item drawn there."
      },
      "doc": {
        "type": [
          "string",
          "null"
        ]
      },
      "node": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "The object to read; it needs an `id`. In the previewed document\nunless `doc` names another. Left out, the call only clicks: a\nprototype plays without an `id` on the object whose state it reads."
      },
      "set": {
        "additionalProperties": true,
        "description": "Values to assign to a block's state (mocked previews only).",
        "type": [
          "object",
          "null"
        ]
      }
    },
    "title": "StateArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_state",
  "outputSchema": {
    "properties": {
      "block": {
        "description": "`Module.Name`, when the object is a block.",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "description": "The object read; absent when only a click was asked for.",
        "type": [
          "string",
          "null"
        ]
      },
      "mocked": {
        "type": "boolean"
      },
      "state": {
        "additionalProperties": true,
        "description": "A block's published state as the preview has it now.",
        "type": "object"
      },
      "variant": {
        "description": "The object's QML `state` now: the variant it shows, `\"\"` for its\nbase state. Absent when no object was read.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "state",
      "mocked"
    ],
    "title": "StateOut",
    "type": "object"
  },
  "required_cap": "run"
}
