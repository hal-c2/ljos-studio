---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Read an object in the preview: its QML state (`variant`), a block's published state (`set` assigns it when mocked), and the properties in `read`. Input comes first, as a person's.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "`node` (session handle), `id`, or `document_tree` `path` (this text only).",
        "type": "object"
      },
      "Wheel": {
        "properties": {
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "properties": {
      "click": {
        "$ref": "#/$defs/Address",
        "description": "An object, by `id`, to click first, after `set`."
      },
      "click_at": {
        "description": "A point to click instead: what is on top gets it.",
        "properties": {
          "x": {
            "description": "Logical pixels.",
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "doc": {
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address",
        "description": "The object to read, by `id`; in the previewed document unless `doc` names another. Left out, it only acts."
      },
      "press": {
        "description": "Keys: `Ctrl+A Enter`.",
        "type": "string"
      },
      "read": {
        "description": "Properties of `node` to read into `state`.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "scroll": {
        "$ref": "#/$defs/Wheel",
        "description": "Wheel notches; negative `dy` is down."
      },
      "set": {
        "additionalProperties": true,
        "description": "Values to assign to a block's state (mocked previews only).",
        "type": "object"
      },
      "show": {
        "description": "Show `node` in this QML state through reloads, until `\"\"`.",
        "type": "string"
      },
      "swipe": {
        "$ref": "#/$defs/Wheel",
        "description": "A drag, in pixels."
      },
      "type": {
        "type": "string"
      },
      "type_into": {
        "$ref": "#/$defs/Address",
        "description": "Where `type` goes; default: the focus."
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_state",
  "outputSchema": {
    "properties": {
      "block": {},
      "id": {},
      "mocked": {
        "type": "boolean"
      },
      "state": {
        "type": "object"
      },
      "variant": {}
    },
    "required": [
      "state",
      "mocked"
    ],
    "type": "object"
  },
  "required_cap": "run"
}
