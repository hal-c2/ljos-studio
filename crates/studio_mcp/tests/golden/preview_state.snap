---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Read an object in the preview: its QML state (`variant`), a block's published state, which `set` assigns when the block is mocked, and any property named in `read`. `click` or `click_at` clicks first, as a person does, so a flow plays. Objects are found by `id`.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ClickAt": {
        "properties": {
          "x": {
            "description": "The preview's logical pixels.",
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "properties": {
      "click": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "An object (with an `id`) to click first, after `set`, as a person\ndoes: the app's own handlers answer, so a flow plays."
      },
      "click_at": {
        "anyOf": [
          {
            "$ref": "#/$defs/ClickAt"
          },
          {
            "type": "null"
          }
        ],
        "description": "A point to click instead, exactly there: whatever is on top gets it."
      },
      "doc": {
        "type": [
          "string",
          "null"
        ]
      },
      "node": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "The object to read; it needs an `id`. In the previewed document\nunless `doc` names another. Left out, the call only clicks: a\nprototype plays without an `id` on the object whose state it reads."
      },
      "read": {
        "default": [],
        "description": "Properties of `node` to read into `state`, as the running app has\nthem: what an expression works out to.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "set": {
        "additionalProperties": true,
        "description": "Values to assign to a block's state (mocked previews only).",
        "type": [
          "object",
          "null"
        ]
      },
      "show": {
        "description": "Put `node` in this QML state of its own for the preview, through\nreloads, until `\"\"`; the file does not change.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_state",
  "outputSchema": {
    "properties": {
      "block": {
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "type": [
          "string",
          "null"
        ]
      },
      "mocked": {
        "type": "boolean"
      },
      "state": {
        "type": "object"
      },
      "variant": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "state",
      "mocked"
    ],
    "type": "object"
  },
  "required_cap": "run"
}
