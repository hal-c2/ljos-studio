---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": false
  },
  "description": "Read an object in the preview: its QML state (`variant`), a block's published state (`set` assigns it when mocked), and the properties in `read`. First, as a person would: `click` or `click_at`, `scroll`, `swipe`, `press` keys, `type` text, so a flow plays. Objects are found by `id`.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      },
      "Wheel": {
        "properties": {
          "dx": {
            "default": 0.0,
            "type": "number"
          },
          "dy": {
            "default": 0.0,
            "type": "number"
          },
          "x": {
            "description": "Where, in the preview's logical pixels.",
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "properties": {
      "click": {
        "$ref": "#/$defs/Address",
        "description": "An object (with an `id`) to click first, after `set`, as a person does; its handlers answer."
      },
      "click_at": {
        "description": "A point to click instead, exactly there: whatever is on top gets it.",
        "properties": {
          "x": {
            "description": "The preview's logical pixels.",
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "doc": {
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address",
        "description": "The object to read, with an `id`; in the previewed document unless `doc` names another. Left out, the call only clicks."
      },
      "press": {
        "description": "Keys pressed in turn, after any scroll: `Enter`, `Ctrl+A`, several separated by a space.",
        "type": "string"
      },
      "read": {
        "description": "Properties of `node` to read into `state`, as the running app has them.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "scroll": {
        "$ref": "#/$defs/Wheel",
        "description": "The wheel turned at a point, after any click, in notches: a negative `dy` shows what is further down."
      },
      "set": {
        "additionalProperties": true,
        "description": "Values to assign to a block's state (mocked previews only).",
        "type": "object"
      },
      "show": {
        "description": "Show `node` in this QML state through reloads, until `\"\"`.",
        "type": "string"
      },
      "swipe": {
        "$ref": "#/$defs/Wheel",
        "description": "A finger put down at a point and dragged by `dx`, `dy` pixels, then lifted."
      },
      "type": {
        "description": "Text typed into what has the keyboard, last (a `click` gives a field the keyboard).",
        "type": "string"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_state",
  "outputSchema": {
    "properties": {
      "block": {},
      "id": {},
      "mocked": {
        "type": "boolean"
      },
      "state": {
        "type": "object"
      },
      "variant": {}
    },
    "required": [
      "state",
      "mocked"
    ],
    "type": "object"
  },
  "required_cap": "run"
}
