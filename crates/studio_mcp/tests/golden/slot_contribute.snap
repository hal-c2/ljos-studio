---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a Contribution to a block's slot, showing QML `text` or a `block`, importing Ljos.Blocks and the block's module once; or `remove` one. Refuses a slot no block offers (`blocks_list`).",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Mode": {
        "description": "How a contribution joins what the slot already holds.",
        "enum": [
          "append",
          "prepend",
          "replace"
        ],
        "type": "string"
      }
    },
    "properties": {
      "block": {
        "description": "Or a block from `blocks_list`, `Module.Name`, shown bare.",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "type": [
          "integer",
          "null"
        ]
      },
      "mode": {
        "anyOf": [
          {
            "$ref": "#/$defs/Mode"
          },
          {
            "type": "null"
          }
        ],
        "description": "How it joins what the slot holds; the runtime's default when left out."
      },
      "order": {
        "description": "Its place among the slot's contributions.",
        "type": [
          "integer",
          "null"
        ]
      },
      "parent": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "Where the `Contribution` goes; the root when left out."
      },
      "remove": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "Take this `Contribution` out instead."
      },
      "slot": {
        "description": "The slot, as `blocks_list` lists it (`controls`).",
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "description": "What it shows: one object in QML.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "slot_contribute",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
