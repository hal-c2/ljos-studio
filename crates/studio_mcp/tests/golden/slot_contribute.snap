---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a Contribution of QML `text` or a `block` to a block's slot (imports added once), or `remove` one. Refuses a slot no `blocks_list` block offers.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Session handle `node`, `id`, or `document_tree` `path` (this text only).",
        "type": "object"
      }
    },
    "properties": {
      "block": {
        "description": "Or a `Module.Name` from `blocks_list`, shown bare.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "type": "integer"
      },
      "mode": {
        "description": "How it joins the slot; default the runtime's.",
        "enum": [
          "append",
          "prepend",
          "replace"
        ],
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address",
        "description": "Or the instance to skin alone."
      },
      "order": {
        "description": "Place among the slot's contributions.",
        "type": "integer"
      },
      "parent": {
        "$ref": "#/$defs/Address",
        "description": "Where it goes; default the root."
      },
      "remove": {
        "$ref": "#/$defs/Address",
        "description": "Contribution to take out instead."
      },
      "slot": {
        "description": "As in `blocks_list` (`controls`).",
        "type": "string"
      },
      "text": {
        "description": "One QML object to show.",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "slot_contribute",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "id": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
