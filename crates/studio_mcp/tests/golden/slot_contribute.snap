---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Write a Contribution to a block's slot, showing QML `text` or a `block` (imports added once); or `remove` one. Refuses a slot no block offers (`blocks_list`).",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      }
    },
    "properties": {
      "block": {
        "description": "Or a block from `blocks_list`, `Module.Name`, shown bare.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "type": "integer"
      },
      "mode": {
        "description": "How it joins what the slot holds; the runtime's default when left out.",
        "enum": [
          "append",
          "prepend",
          "replace"
        ],
        "type": "string"
      },
      "order": {
        "description": "Its place among the slot's contributions.",
        "type": "integer"
      },
      "parent": {
        "$ref": "#/$defs/Address",
        "description": "Where the `Contribution` goes; the root when left out."
      },
      "remove": {
        "$ref": "#/$defs/Address",
        "description": "Take this `Contribution` out instead."
      },
      "slot": {
        "description": "The slot, as `blocks_list` lists it (`controls`).",
        "type": "string"
      },
      "text": {
        "description": "What it shows: one object in QML.",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "slot_contribute",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
