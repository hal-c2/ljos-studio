---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Read the tokens of Ljos.Design, the module's value beside the theme file's; or set one (`null` gives it back) in the theme file Ljós reads, the project's made when none, the rest kept byte for byte. A theme Ljós would refuse is refused with its message.",
  "inputSchema": {
    "$defs": {
      "Variant": {
        "enum": [
          "light",
          "dark",
          "lightHigh",
          "darkHigh"
        ],
        "type": "string"
      }
    },
    "properties": {
      "doc": {
        "description": "A document whose theme it is: the nearest `theme.json` up from it.\nThe open preview's when left out, else the project's own.",
        "type": [
          "string",
          "null"
        ]
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "description": "The theme file's generation the edit was read at; 0 while it does\nnot exist.",
        "type": [
          "integer",
          "null"
        ]
      },
      "token": {
        "description": "`Colors.accent`; a singleton (`Spacing`) reads its roles. Every role\nwhen left out.",
        "type": [
          "string",
          "null"
        ]
      },
      "value": {
        "default": null,
        "description": "What the token becomes; `null` gives it back to the module. Left\nout, the tokens are read."
      },
      "variant": {
        "anyOf": [
          {
            "$ref": "#/$defs/Variant"
          },
          {
            "type": "null"
          }
        ],
        "description": "One variant of a colour; a colour string sets light and dark."
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "theme_set",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": [
          "array",
          "null"
        ]
      },
      "doc": {
        "type": [
          "string",
          "null"
        ]
      },
      "exists": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "file": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "problem": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "tokens": {
        "type": [
          "array",
          "null"
        ]
      },
      "unchanged": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "file",
      "generation"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
