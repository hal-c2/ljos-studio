---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Read the tokens of Ljos.Design, the module's value beside the theme file's; or set one (`null` gives it back) in the theme file (made if none), the rest kept byte for byte. A theme Ljós would refuse is refused.",
  "inputSchema": {
    "properties": {
      "doc": {
        "description": "Whose theme: the nearest `theme.json` up from it; left out, the preview's, else the project's.",
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The theme file's generation the edit was read at; 0 while it does not exist.",
        "type": "integer"
      },
      "token": {
        "description": "`Colors.accent`; a singleton (`Spacing`) reads its roles. Every role when left out.",
        "type": "string"
      },
      "value": {
        "description": "What the token becomes; `null` gives it back to the module. Left out, the tokens are read."
      },
      "variant": {
        "description": "One variant of a colour; a colour string sets light and dark.",
        "enum": [
          "light",
          "dark",
          "lightHigh",
          "darkHigh"
        ],
        "type": "string"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "theme_set",
  "outputSchema": {
    "properties": {
      "changes": {},
      "doc": {},
      "exists": {},
      "file": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "problem": {},
      "text": {},
      "tokens": {},
      "unchanged": {}
    },
    "required": [
      "file",
      "generation"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
