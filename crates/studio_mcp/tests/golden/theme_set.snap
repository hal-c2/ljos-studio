---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Read Ljos.Design's tokens, the module's value beside the theme file's; or set one in that file (made if none), the rest kept byte for byte. A theme Ljós would refuse is refused.",
  "inputSchema": {
    "properties": {
      "doc": {
        "description": "Whose theme: the nearest `theme.json` up from it; left out, the preview's, else the project's.",
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The theme file's, as read; 0 while there is none.",
        "type": "integer"
      },
      "token": {
        "description": "`Colors.accent`, or a singleton (`Spacing`). Left out: every name, and what the theme sets.",
        "type": "string"
      },
      "value": {
        "description": "`null` gives it back to the module. Left out, the tokens are read."
      },
      "variant": {
        "description": "One variant of a colour; a colour string sets light and dark.",
        "enum": [
          "light",
          "dark",
          "lightHigh",
          "darkHigh"
        ],
        "type": "string"
      },
      "verbose": {
        "description": "With no `token`: every value.",
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "theme_set",
  "outputSchema": {
    "properties": {
      "changes": {},
      "doc": {},
      "exists": {},
      "file": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "problem": {},
      "roles": {},
      "text": {},
      "tokens": {},
      "unchanged": {}
    },
    "required": [
      "file",
      "generation"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
