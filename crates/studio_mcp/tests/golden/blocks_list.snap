  "description": "List the project's functional blocks with their contracts; `node_insert` places one by `Module.Name`. Unreadable ones are in `errors`. With `doc`, `types` lists the toolkit types it can place: its imports first, and `node_insert`'s `import` adds a missing one.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "description": "From a previous page's `next`.",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "description": "Also answer `types`, the toolkit types this document can place.",
        "type": [
          "string",
          "null"
        ]
      },
      "module": {
        "description": "Only this module's blocks (`App.Media`).",
        "type": [
          "string",
          "null"
        ]
      },
      "search": {
        "description": "Only blocks and types whose name holds this, in any case.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "BlocksArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "blocks_list",
  "outputSchema": {
    "$defs": {
      "Group": {
        "description": "One module's types.",
        "properties": {
          "imported": {
            "description": "The document imports it; otherwise placing a type adds the import.",
