---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Replace a byte range of a document's text, as the code view does. It may leave the text unparsed; structural edits then wait and handles hold. Needs the generation read.",
  "inputSchema": {
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "end": {
        "type": "integer"
      },
      "generation": {
        "description": "The generation the offsets were read at.",
        "type": "integer"
      },
      "start": {
        "description": "Byte range to replace; the whole text when both are left out.",
        "type": "integer"
      },
      "text": {
        "type": "string"
      },
      "typing": {
        "description": "A person's typing: joins the last in one undo step until a pause of a second or a new word.",
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "text"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "document_edit",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
