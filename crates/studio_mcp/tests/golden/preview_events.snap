{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "The preview's events since a cursor: opened, reloaded (ms), reload_failed (the last good one stays), log lines, ended. `wait_ms` waits instead for it to rest past `rests`, saying `wake_in_ms`.",
  "inputSchema": {
    "properties": {
      "rests": {
        "description": "An earlier answer's `rests`; left out, the answer comes at once.",
        "type": "integer"
      },
      "since": {
        "description": "An earlier answer's `next`; 0 or left out: from the start.",
        "type": "integer"
      },
      "wait_ms": {
        "description": "Wait up to this long instead (3 600 000 at most).",
        "type": "integer"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "preview_events",
  "outputSchema": {
    "properties": {
      "events": {
        "type": "array"
      },
      "next": {
        "type": "integer"
      },
      "open": {
        "type": "boolean"
      },
      "problems": {
        "type": "array"
      },
      "rests": {},
      "wake_in_ms": {}
    },
    "required": [
      "events",
      "next",
      "open"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
