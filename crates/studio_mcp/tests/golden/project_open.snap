---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Open a project below the workspace, or a `folder` the person chose (the workspace, a `recent` one, or one picked in the window), or describe the open one. Opening starts a new session: handles and history end. `asset`: its pictures and fonts; `files`: its other files.",
  "inputSchema": {
    "properties": {
      "asset": {
        "description": "On the project's `assets/`: `list` it, `import` a picture or font (`fs`), `remove` one no document uses (`fs`).",
        "enum": [
          "import",
          "list",
          "remove"
        ],
        "type": "string"
      },
      "data": {
        "description": "`import`: the file's bytes in base64 (a client with no file here); needs `name`.",
        "type": "string"
      },
      "file": {
        "description": "`import`: a file below the workspace; `files`: the project's.",
        "type": "string"
      },
      "files": {
        "description": "`list` (inspect), the rest `fs`; `edit` holds `text` until `save`.",
        "enum": [
          "list",
          "read",
          "edit",
          "save",
          "save_all",
          "revert",
          "close",
          "new",
          "rename",
          "remove"
        ],
        "type": "string"
      },
      "folder": {
        "description": "Absolute; opened as the workspace (`fs`).",
        "type": "string"
      },
      "force": {
        "description": "Drops unsaved edits; saves over a change on disk.",
        "type": "boolean"
      },
      "name": {
        "description": "`import`: the name to give it. `remove`: the asset's name.",
        "type": "string"
      },
      "path": {
        "description": "Relative or absolute (`.` is the workspace). Left out: the open project.",
        "type": "string"
      },
      "text": {
        "description": "`files`: what it holds.",
        "type": "string"
      },
      "to": {
        "description": "`rename`: the new path.",
        "type": "string"
      }
    },
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "project_open",
  "outputSchema": {
    "properties": {
      "asset": {},
      "assets": {},
      "documents": {
        "type": "array"
      },
      "file": {},
      "files": {},
      "more": {},
      "project": {
        "type": "string"
      },
      "recent": {},
      "removed": {},
      "saved": {},
      "unsaved": {}
    },
    "required": [
      "project",
      "documents"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
