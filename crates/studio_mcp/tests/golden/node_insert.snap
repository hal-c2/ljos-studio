---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Insert one object written in QML, or a `block` from `blocks_list`, as a child at an index. It gets an id unless it has one; `import` (a block's module) is added once. Returns the new object's handle.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "block": {
        "description": "A functional block from `blocks_list`, `Module.Name`: its module is\nimported and `text` must be of its type.",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; refused if the document moved on. Needed when\nan address is a `path`, which is true of one generation only.",
        "type": [
          "integer",
          "null"
        ]
      },
      "id": {
        "description": "Give the object an `id` if it has none (default true).",
        "type": [
          "boolean",
          "null"
        ]
      },
      "import": {
        "description": "A module the document must import for it (`Shop.Blocks`).",
        "type": [
          "string",
          "null"
        ]
      },
      "index": {
        "description": "Child position; the end when left out.",
        "type": [
          "integer",
          "null"
        ]
      },
      "parent": {
        "$ref": "#/$defs/Address"
      },
      "text": {
        "description": "One object in QML (`Rectangle { color: \"red\" }`). With `block`, it may\nbe left out for the bare block, or set its inputs.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc",
      "parent"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_insert",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
