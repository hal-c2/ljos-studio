---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Insert in `parent` a QML object or a `blocks_list` `block`, as a child at an index, or a member. It gets an id if it has none. Returns the handle.",
  "inputSchema": {
    "properties": {
      "block": {
        "description": "`Module.Name` from `blocks_list`, imported; `text` must be of its type.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "Generation read; a `path` needs it (handles and ids move past others' edits).",
        "type": "integer"
      },
      "id": {
        "description": "Add an `id` if none (default true).",
        "type": "boolean"
      },
      "import": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "Modules it needs (`Shop.Blocks`); the toolkit's are added."
      },
      "index": {
        "description": "Child position; default the end.",
        "type": "integer"
      },
      "parent": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "`node` (session handle), `id`, or `document_tree` `path` (this text only).",
        "type": "object"
      },
      "replace": {
        "description": "Member to rewrite as `text`; uses keep the old name.",
        "type": "string"
      },
      "slot": {
        "description": "New `Slot`'s name (imports Ljos.Blocks); `text`: its default.",
        "type": "string"
      },
      "text": {
        "description": "One QML object or member (`function f() {}`, `signal s()`, `property int n`, `onClicked: f()`). With `block`: its inputs; none for it bare.",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "parent"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_insert",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "id": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
