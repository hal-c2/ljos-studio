---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Insert one object written in QML, or a `block` from `blocks_list`, as a child at an index. It gets an id unless it has one; `import` (a block's module) is added once. Returns the new object's handle.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "How a caller names an object.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "A handle the session gave out (`n7`); stable for the session.",
            "properties": {
              "node": {
                "type": "string"
              }
            },
            "required": [
              "node"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The object's `id` in the document.",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A path as `document_tree` prints it (`root/0/contentItem:`), true of\nthe current text only.",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          }
        ]
      }
    },
    "additionalProperties": false,
    "properties": {
      "block": {
        "description": "A functional block from `blocks_list`, `Module.Name`: its module is\nimported and `text` must be of its type.",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read. By handle or `id`, the edit is moved past what\nothers wrote since, or refused as a conflict; by `path`, which is true\nof one generation only, it is refused if the document moved on, so\na `path` needs it.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "id": {
        "description": "Give the object an `id` if it has none (default true).",
        "type": [
          "boolean",
          "null"
        ]
      },
      "import": {
        "description": "A module the document must import for it (`Shop.Blocks`).",
        "type": [
          "string",
          "null"
        ]
      },
      "index": {
        "description": "Child position; the end when left out.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "parent": {
        "$ref": "#/$defs/Address"
      },
      "text": {
        "description": "One object in QML (`Rectangle { color: \"red\" }`). With `block`, it may\nbe left out for the bare block, or set its inputs.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc",
      "parent"
    ],
    "title": "InsertArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_insert",
  "outputSchema": {
    "$defs": {
      "ChangeOut": {
        "properties": {
          "end": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "description": "Byte range of the text before the edit.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "type": "object"
      }
    },
    "properties": {
      "changes": {
        "items": {
          "$ref": "#/$defs/ChangeOut"
        },
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "description": "The document's generation now; pass it with the next edit.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "history": {
        "description": "The history entry; absent for a dry run or an unchanged document.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "description": "The handle of the object put or moved.",
        "type": [
          "string",
          "null"
        ]
      },
      "rebased_from": {
        "description": "The `generation` the edit was made against, when the document had\nmoved on since and the edit was applied past what others wrote.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "text": {
        "description": "The text the edit would give, for a dry run.",
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "description": "The document already said this: nothing was written and no history\nentry made.",
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "title": "EditOut",
    "type": "object"
  },
  "required_cap": "mutate"
}
