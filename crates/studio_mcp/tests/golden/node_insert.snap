---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Insert in `parent` a QML object or a `block` from `blocks_list`, as a child at an index, or a member (function, signal, property, handler). It gets an id if it has none. Returns the handle.",
  "inputSchema": {
    "properties": {
      "block": {
        "description": "`Module.Name` from `blocks_list`, imported; `text` must be of its type.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; a `path` needs it (handles and ids are moved past others' edits).",
        "type": "integer"
      },
      "id": {
        "description": "Add an `id` if none (default true).",
        "type": "boolean"
      },
      "import": {
        "description": "A module the document must import for it (`Shop.Blocks`).",
        "type": "string"
      },
      "index": {
        "description": "Child position; default the end.",
        "type": "integer"
      },
      "parent": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      },
      "replace": {
        "description": "Member to rewrite as `text`; uses keep the old name.",
        "type": "string"
      },
      "slot": {
        "description": "Name of a `Slot` to declare (imports Ljos.Blocks); `text` is its default.",
        "type": "string"
      },
      "text": {
        "description": "One QML object or member (`function f() {}`, `signal s()`, `property int n`, `onClicked: f()`). With `block`: its inputs, or none for the bare block.",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "parent"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_insert",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
