---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Insert an object written in QML, or a `block` from `blocks_list`, as a child at an index, or a member (function, signal, property, handler) of `parent`. It gets an id unless it has one. Returns the handle.",
  "inputSchema": {
    "properties": {
      "block": {
        "description": "A block from `blocks_list`, `Module.Name`; imported, and `text` must be of its type.",
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; a `path` needs it (handles and ids are moved past others' edits).",
        "type": "integer"
      },
      "id": {
        "description": "Give the object an `id` if it has none (default true).",
        "type": "boolean"
      },
      "import": {
        "description": "A module the document must import for it (`Shop.Blocks`).",
        "type": "string"
      },
      "index": {
        "description": "Child position; the end when left out.",
        "type": "integer"
      },
      "parent": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      },
      "text": {
        "description": "One object in QML, or one member (`function f() {}`, `signal s()`, `property int n`, `onClicked: f()`). With `block`: left out for the bare block, or its inputs.",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "parent"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_insert",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
