---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Design review comments on objects, kept in `.studio/`, never in the QML: add, reply, resolve, reopen, or list by doc and node. A comment follows its object through edits; if it is removed the comment stays, orphaned.",
  "inputSchema": {
    "properties": {
      "action": {
        "enum": [
          "add",
          "reply",
          "resolve",
          "reopen",
          "list"
        ],
        "type": "string"
      },
      "author": {
        "description": "Who says it; the caller's own name if absent.",
        "type": "string"
      },
      "comment": {
        "description": "The comment's id (`reply`, `resolve`, `reopen`).",
        "type": "string"
      },
      "doc": {
        "description": "The document (`add`; `list` filters by it).",
        "type": "string"
      },
      "node": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "The object (`add`; `list` filters by it, with `doc`).",
        "type": "object"
      },
      "text": {
        "description": "What the comment or reply says.",
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "review",
  "outputSchema": {
    "properties": {
      "comment": {},
      "comments": {}
    },
    "type": "object"
  },
  "required_cap": "inspect"
}
