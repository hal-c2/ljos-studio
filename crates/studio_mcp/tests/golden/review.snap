---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Design review comments on objects, kept in Studio's sidecar (`.studio/`), never in the QML: add, reply, resolve, reopen, or list by doc and node. A comment follows its object through edits; one whose object is removed stays, orphaned, at its last place.",
  "inputSchema": {
    "$defs": {
      "Action": {
        "enum": [
          "add",
          "reply",
          "resolve",
          "reopen",
          "list"
        ],
        "type": "string"
      },
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "properties": {
      "action": {
        "$ref": "#/$defs/Action"
      },
      "author": {
        "description": "Who says it.",
        "type": [
          "string",
          "null"
        ]
      },
      "comment": {
        "description": "The comment's id (`reply`, `resolve`, `reopen`).",
        "type": [
          "string",
          "null"
        ]
      },
      "doc": {
        "description": "The document (`add`; `list` filters by it).",
        "type": [
          "string",
          "null"
        ]
      },
      "node": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "The object (`add`; `list` filters by it, with `doc`)."
      },
      "text": {
        "description": "What the comment or reply says.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "review",
  "outputSchema": {
    "properties": {
      "comment": {},
      "comments": {
        "type": [
          "array",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "required_cap": "inspect"
}
