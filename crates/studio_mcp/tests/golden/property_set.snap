---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Set a property to a literal (bool, number, string) or remove it with null. Grouped and dotted forms are one property; a new one follows the file's style.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LiteralArg": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "description": "A literal a property is set to."
      }
    },
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read. By handle or `id`, the edit is moved past what\nothers wrote since, or refused as a conflict; by `path`, which is true\nof one generation only, it is refused if the document moved on, so\na `path` needs it.",
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "description": "`width`, `font.bold`; written grouped or dotted as the file already does.",
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address"
      },
      "value": {
        "anyOf": [
          {
            "$ref": "#/$defs/LiteralArg"
          },
          {
            "type": "null"
          }
        ],
        "description": "`null` removes the binding. Required: left out, nothing is removed."
      }
    },
    "required": [
      "doc",
      "node",
      "name",
      "value"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "property_set",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "rebased_from": {
        "type": [
          "integer",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
