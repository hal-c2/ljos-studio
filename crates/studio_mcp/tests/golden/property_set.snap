---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Set a property to a literal (bool, number, string), or remove it with null. Grouped and dotted forms are one property; a new one follows the file's style.",
  "inputSchema": {
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; a `path` needs it (handles and ids are moved past others' edits).",
        "type": "integer"
      },
      "name": {
        "description": "`width`, `font.bold`; written grouped or dotted as the file already does.",
        "type": "string"
      },
      "node": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      },
      "value": {
        "description": "`null` removes the binding. Required.",
        "type": [
          "boolean",
          "number",
          "string"
        ]
      }
    },
    "required": [
      "doc",
      "node",
      "name",
      "value"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "property_set",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
