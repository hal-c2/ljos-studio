---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Set Studio's selection, shown on the canvas and in the inspector, by addresses or by a point `at` in the document's preview (the object declared there). Empty clears it.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "properties": {
      "add": {
        "default": false,
        "description": "Toggle these in the selection instead of replacing it.",
        "type": "boolean"
      },
      "at": {
        "anyOf": [
          {
            "$ref": "#/$defs/Point"
          },
          {
            "type": "null"
          }
        ],
        "description": "Instead of `nodes`: a point in the open preview of `doc`, in its\nlogical pixels. Selects the object declared where the preview's\ntopmost object there is declared; nothing there clears it."
      },
      "doc": {
        "type": "string"
      },
      "nodes": {
        "default": [],
        "description": "Empty clears the selection.",
        "items": {
          "$ref": "#/$defs/Address"
        },
        "type": "array"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_select",
  "outputSchema": {
    "properties": {
      "selection": {
        "type": "array"
      }
    },
    "required": [
      "selection"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
