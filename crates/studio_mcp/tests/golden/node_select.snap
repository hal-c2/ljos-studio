---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Set Studio's selection, shown on the canvas and in the inspector, by addresses or by a point `at` in the document's preview (the object declared there). Empty clears it.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "How a caller names an object.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "A handle the session gave out (`n7`); stable for the session.",
            "properties": {
              "node": {
                "type": "string"
              }
            },
            "required": [
              "node"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The object's `id` in the document.",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A path as `document_tree` prints it (`root/0/contentItem:`), true of\nthe current text only.",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          }
        ]
      },
      "Point": {
        "additionalProperties": false,
        "properties": {
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "at": {
        "anyOf": [
          {
            "$ref": "#/$defs/Point"
          },
          {
            "type": "null"
          }
        ],
        "description": "Instead of `nodes`: a point in the open preview of `doc`, in its\nlogical pixels. Selects the object declared where the preview's\ntopmost object there is declared; nothing there clears it."
      },
      "doc": {
        "type": "string"
      },
      "hold": {
        "default": false,
        "description": "Also hold the selected objects and all they hold (`mutate`): another\nwriter's edit of them is refused as `busy` until the caller has made\nno call for five seconds, and for five minutes at most. Selecting\nnothing lets go of what the caller holds.",
        "type": "boolean"
      },
      "nodes": {
        "default": [],
        "description": "Empty clears the selection.",
        "items": {
          "$ref": "#/$defs/Address"
        },
        "type": "array"
      }
    },
    "required": [
      "doc"
    ],
    "title": "SelectArgs",
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_select",
  "outputSchema": {
    "$defs": {
      "Found": {
        "properties": {
          "doc": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "doc",
          "node",
          "path",
          "type"
        ],
        "type": "object"
      }
    },
    "properties": {
      "held": {
        "description": "The handles of `doc` the caller holds.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "selection": {
        "items": {
          "$ref": "#/$defs/Found"
        },
        "type": "array"
      }
    },
    "required": [
      "selection",
      "held"
    ],
    "title": "Selection",
    "type": "object"
  },
  "required_cap": "inspect"
}
