---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "read_only": true
  },
  "description": "Set Studio's selection (canvas and inspector) by addresses, or by a point `at` in the document's preview. Empty clears it.",
  "inputSchema": {
    "properties": {
      "add": {
        "description": "Toggle these in the selection instead of replacing it.",
        "type": "boolean"
      },
      "at": {
        "description": "Instead of `nodes`: a point in the open preview, in logical pixels; selects what is declared where the topmost object is. Nothing there clears it.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "doc": {
        "type": "string"
      },
      "hold": {
        "description": "Also hold the selected objects and what they hold (`mutate`): others' edits of them are `busy` until the caller is idle five seconds (five minutes at most). Selecting nothing lets go.",
        "type": "boolean"
      },
      "nodes": {
        "description": "Empty or null clears the selection.",
        "items": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_select",
  "outputSchema": {
    "properties": {
      "held": {
        "type": "array"
      },
      "selection": {
        "type": "array"
      }
    },
    "required": [
      "selection",
      "held"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
