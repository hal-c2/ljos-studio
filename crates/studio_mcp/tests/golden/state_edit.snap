---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "States: add, rename, remove; change a value or the `when` (`breakpoint`: the root's width bound); add or remove a Transition; write or remove a flow (a tap on `trigger` goes to `state` or opens a document). `would_break` if the file would not parse.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      }
    },
    "properties": {
      "action": {
        "enum": [
          "add",
          "rename",
          "remove",
          "add_transition",
          "remove_transition",
          "remove_interaction",
          "change",
          "when",
          "interaction"
        ],
        "type": "string"
      },
      "animations": {
        "description": "`add_transition`: the animations it runs, in QML.",
        "type": "string"
      },
      "binding": {
        "description": "`change`: an expression (`root.width / 2`).",
        "type": "string"
      },
      "breakpoint": {
        "description": "`add`, `when`: a preview target whose width bound is the `when`.",
        "enum": [
          "desktop",
          "tablet",
          "phone"
        ],
        "type": "string"
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "from": {
        "description": "Transitions: the states between; `*` (any) if left out.",
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "name": {
        "description": "`change`: its property (`text`, `anchors.left`).",
        "type": "string"
      },
      "navigator": {
        "$ref": "#/$defs/Address",
        "description": "`interaction`: the `Loader` or `StackView` that opens it."
      },
      "new_name": {
        "description": "`rename`: the new name.",
        "type": "string"
      },
      "node": {
        "$ref": "#/$defs/Address",
        "description": "The object whose states these are; the root when left out."
      },
      "open": {
        "description": "`interaction`: a document beside this one to open, not with `state`.",
        "type": "string"
      },
      "signal": {
        "description": "Interactions: its signal (`clicked`); a `TapHandler`'s tap if left out.",
        "type": "string"
      },
      "state": {
        "description": "The state's name; all but the transition actions need it.",
        "type": "string"
      },
      "target": {
        "$ref": "#/$defs/Address",
        "description": "`change`: the object, which must have an id."
      },
      "to": {
        "type": "string"
      },
      "trigger": {
        "$ref": "#/$defs/Address",
        "description": "Interactions: the object tapped."
      },
      "value": {
        "description": "`change`: a literal; with neither this nor `binding`, the value is removed.",
        "type": [
          "boolean",
          "number",
          "string"
        ]
      },
      "when": {
        "description": "`add`, `when`: the condition, QML after `when:`; left out of `when`, removes it.",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "state_edit",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
