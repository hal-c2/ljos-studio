---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Add, rename or remove an object's State; set or remove a value it changes or its `when` (`breakpoint`: the root's width bound); add or remove a Transition; write or take out a flow: a tap on `trigger` goes to `state` or opens a document. Refused with `would_break` if the file would not parse.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "description": "One of: `node`, a handle the session gave out (`n7`), stable for the session; `id`, the object's `id`; `path`, as `document_tree` prints it (`root/0/contentItem:`), true of the current text only.",
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LiteralArg": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "description": "A literal a property is set to."
      },
      "StateAction": {
        "oneOf": [
          {
            "enum": [
              "add",
              "rename",
              "remove",
              "add_transition",
              "remove_transition",
              "remove_interaction"
            ],
            "type": "string"
          },
          {
            "const": "change",
            "description": "Set or remove one value the state changes.",
            "type": "string"
          },
          {
            "const": "when",
            "description": "Set or remove the state's `when`.",
            "type": "string"
          },
          {
            "const": "interaction",
            "description": "A flow on `trigger`: to `state` or, by `navigator`, to `open`.",
            "type": "string"
          }
        ]
      },
      "Target": {
        "description": "The shape of screen a preview is laid out for.",
        "enum": [
          "desktop",
          "tablet",
          "phone"
        ],
        "type": "string"
      }
    },
    "properties": {
      "action": {
        "$ref": "#/$defs/StateAction"
      },
      "animations": {
        "description": "`add_transition`: the animations it runs, in QML.",
        "type": [
          "string",
          "null"
        ]
      },
      "binding": {
        "description": "`change`: an expression (`root.width / 2`).",
        "type": [
          "string",
          "null"
        ]
      },
      "breakpoint": {
        "anyOf": [
          {
            "$ref": "#/$defs/Target"
          },
          {
            "type": "null"
          }
        ],
        "description": "`add`, `when`: a preview target whose width bound becomes the `when`\n(`root.width < 600`); not with `when`."
      },
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      },
      "from": {
        "description": "Transitions: the states it runs between; `*` (any) when left out.",
        "type": [
          "string",
          "null"
        ]
      },
      "generation": {
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "description": "`change`: its property (`text`, `anchors.left`).",
        "type": [
          "string",
          "null"
        ]
      },
      "navigator": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "`interaction`: the `Loader` or `StackView` that opens it."
      },
      "new_name": {
        "description": "`rename`: the new name.",
        "type": [
          "string",
          "null"
        ]
      },
      "node": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "The object whose states these are; the root when left out."
      },
      "open": {
        "description": "`interaction`: a document beside this one to open, not with `state`.",
        "type": [
          "string",
          "null"
        ]
      },
      "signal": {
        "description": "Interactions: its signal (`clicked`), handled as `onClicked`; a\n`TapHandler`'s tap when left out.",
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "description": "The state's name; every action but the transition ones needs it.",
        "type": [
          "string",
          "null"
        ]
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "`change`: the object, which must have an id."
      },
      "to": {
        "type": [
          "string",
          "null"
        ]
      },
      "trigger": {
        "anyOf": [
          {
            "$ref": "#/$defs/Address"
          },
          {
            "type": "null"
          }
        ],
        "description": "Interactions: the object tapped."
      },
      "value": {
        "anyOf": [
          {
            "$ref": "#/$defs/LiteralArg"
          },
          {
            "type": "null"
          }
        ],
        "description": "`change`: a literal. With neither this nor `binding`, the value is\nremoved."
      },
      "when": {
        "description": "`add`, `when`: the condition, QML after `when:`. Left out of `when`,\nit removes it.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "doc",
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "state_edit",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {
        "type": [
          "integer",
          "null"
        ]
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "rebased_from": {
        "type": [
          "integer",
          "null"
        ]
      },
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
