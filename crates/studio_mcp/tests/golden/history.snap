{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "List edits (`inspect`), or undo or redo the last one (`mutate`). Undo gives back the document's bytes.",
  "inputSchema": {
    "$defs": {
      "HistoryAction": {
        "enum": [
          "list",
          "undo",
          "redo"
        ],
        "type": "string"
      }
    },
    "properties": {
      "action": {
        "$ref": "#/$defs/HistoryAction"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "history",
  "outputSchema": {
    "properties": {
      "done": {
        "type": "array"
      },
      "entry": {},
      "generation": {
        "type": [
          "integer",
          "null"
        ]
      },
      "undone": {
        "type": "array"
      }
    },
    "required": [
      "done",
      "undone"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
