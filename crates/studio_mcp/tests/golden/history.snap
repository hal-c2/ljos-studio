---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "List edits and their authors (`inspect`), or undo or redo the caller's last (`mutate`), moved past others' edits; `all` takes the newest whoever made it. Undo gives back the document's bytes.",
  "inputSchema": {
    "properties": {
      "action": {
        "enum": [
          "list",
          "undo",
          "redo"
        ],
        "type": "string"
      },
      "all": {
        "description": "Undo or redo the newest edit whoever made it, not the caller's own.",
        "type": "boolean"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "history",
  "outputSchema": {
    "properties": {
      "done": {
        "type": "array"
      },
      "entry": {},
      "generation": {},
      "undone": {
        "type": "array"
      }
    },
    "required": [
      "done",
      "undone"
    ],
    "type": "object"
  },
  "required_cap": "inspect"
}
