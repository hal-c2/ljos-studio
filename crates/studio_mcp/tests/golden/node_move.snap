---
source: crates/studio_mcp/tests/golden_tools.rs
expression: value
---
{
  "annotations": {
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "read_only": false
  },
  "description": "Move an object to a parent and child index, with its comments: reorder or reparent.",
  "inputSchema": {
    "$defs": {
      "Address": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "One of `node` (session handle), `id`, `path` (from `document_tree`; this text only).",
        "type": "object"
      }
    },
    "properties": {
      "doc": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "generation": {
        "description": "The generation read; a `path` needs it (handles and ids are moved past others' edits).",
        "type": "integer"
      },
      "index": {
        "description": "Index in the new parent, without the moved object; the end if left out.",
        "type": "integer"
      },
      "node": {
        "$ref": "#/$defs/Address"
      },
      "parent": {
        "$ref": "#/$defs/Address"
      }
    },
    "required": [
      "doc",
      "node",
      "parent"
    ],
    "type": "object"
  },
  "max_result_bytes": 40960,
  "name": "node_move",
  "outputSchema": {
    "properties": {
      "changes": {
        "type": "array"
      },
      "doc": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "history": {},
      "node": {},
      "rebased_from": {},
      "text": {},
      "unchanged": {
        "type": "boolean"
      }
    },
    "required": [
      "doc",
      "generation",
      "changes",
      "unchanged"
    ],
    "type": "object"
  },
  "required_cap": "mutate"
}
