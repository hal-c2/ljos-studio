#!/usr/bin/env bash
#MISE description="Run Studio: its native window on DIR (anything after -- goes to studio), or with --web in a browser (mise run web:serve). mise run studio is the same task"
#MISE alias="studio"
#USAGE flag "--web" help="Studio in a browser instead of the native window: serves it on localhost (needs ljos-web beside this checkout: mise run setup --web)"
#USAGE flag "--port <port>" env="PORT" default="5199" help="With --web, the port to serve on"
#USAGE flag "--caps <caps>" help="Native: what an agent may do, a comma-separated list of inspect, mutate, fs and run (default inspect)"
#USAGE flag "--no-agents" help="Native: serve no tools to agents while the window is open"
#USAGE flag "--mcp" help="Native: serve Studio's tools on stdin and stdout, with no window"
#USAGE flag "--shell <dir>" help="Native: a shell of your own, a directory of QML whose Shell.qml the window shows"
#USAGE flag "--theme <file>" help="Native: the theme file Studio's own window is drawn with"
#USAGE flag "--ljos <file>" help="Native: the ljos program previews run (default LJOS, else the one setup installed)"
#USAGE arg "[dir]" help="Native: the project to open; default a copy of samples/hello in the target"
#USAGE arg "[studio_args]" var=#true help="Native: more arguments for studio, after -- and after DIR (mise run dev DIR -- --mcp; see cargo run -p studio -- --help)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"
# One task under two names, so the flags are declared once: `dev` is the
# standard verb, `studio` the name the docs and older habits use.
if [ "${usage_web:-false}" = true ]; then
  if [ -n "${usage_dir:-}${usage_caps:-}${usage_ljos:-}${usage_shell:-}${usage_theme:-}${usage_studio_args:-}" ] ||
    [ "${usage_no_agents:-false}" = true ] || [ "${usage_mcp:-false}" = true ]; then
    echo "dev --web takes no DIR, --caps, --no-agents, --mcp, --shell, --theme, --ljos or arguments for studio: projects live in the browser's storage" >&2
    exit 2
  fi
  port="${usage_port:-5199}"
  # web:serve reads its own usage_ variables; none of these leak in.
  for var in ${!usage_@}; do unset "$var"; done
  PORT="$port" exec mise run web:serve
fi
set --
[ -z "${usage_caps:-}" ] || set -- "$@" --caps "$usage_caps"
[ "${usage_no_agents:-false}" != true ] || set -- "$@" --no-agents
[ "${usage_mcp:-false}" != true ] || set -- "$@" --mcp
[ -z "${usage_shell:-}" ] || set -- "$@" --shell "$(from_asked "$usage_shell")"
[ -z "${usage_theme:-}" ] || set -- "$@" --theme "$(from_asked "$usage_theme")"
# As LJOS, which studio reads too: so run_studio's search for one takes it
# and does not refuse for want of an installed one.
if [ -n "${usage_ljos:-}" ]; then
  LJOS="$(program_asked "$usage_ljos")"
  export LJOS
fi
dir="${usage_dir:-}"
decode_args "${usage_studio_args:-}"
flag_not_dir
[ ${#decoded[@]} -eq 0 ] || set -- "$@" "${decoded[@]}"
run_studio "$dir" "$@"
