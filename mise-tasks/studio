#!/usr/bin/env bash
#MISE description="Studio's window on the project in DIR (a copy of samples/hello when left out); anything after -- goes to studio"
#USAGE arg "[dir]" help="The project to open; default a copy of samples/hello in the target"
#USAGE arg "[studio_args]" var=#true help="More arguments for studio, after -- (see cargo run -p studio -- --help)"
#USAGE flag "--caps <caps>" help="What an agent may do: a comma-separated list of inspect, mutate, fs and run (default inspect)"
#USAGE flag "--no-agents" help="Serve no tools to agents while the window is open"
#USAGE flag "--mcp" help="Serve Studio's tools on stdin and stdout, with no window"
#USAGE flag "--shell <dir>" help="A shell of your own: a directory of QML whose Shell.qml the window shows"
#USAGE flag "--theme <file>" help="The theme file Studio's own window is drawn with"
#USAGE flag "--ljos <file>" help="The ljos program previews run (default LJOS, else the one setup installed)"
set -euo pipefail
. "$(dirname "$0")/_lib/env.sh"
set --
[ -z "${usage_caps:-}" ] || set -- "$@" --caps "$usage_caps"
[ "${usage_no_agents:-false}" != true ] || set -- "$@" --no-agents
[ "${usage_mcp:-false}" != true ] || set -- "$@" --mcp
[ -z "${usage_shell:-}" ] || set -- "$@" --shell "$(from_asked "$usage_shell")"
[ -z "${usage_theme:-}" ] || set -- "$@" --theme "$(from_asked "$usage_theme")"
# As LJOS, which studio reads too: so run_studio's search for one takes it
# and does not refuse for want of an installed one.
if [ -n "${usage_ljos:-}" ]; then
  LJOS="$(from_asked "$usage_ljos")"
  export LJOS
fi
decode_args "${usage_studio_args:-}"
[ ${#decoded[@]} -eq 0 ] || set -- "$@" "${decoded[@]}"
run_studio "${usage_dir:-}" "$@"
