#!/usr/bin/env bash
#MISE description="Studio's window on the project in DIR (a copy of samples/hello when left out); anything after DIR goes to studio"
set -euo pipefail
. "$(dirname "$0")/_lib/env.sh"
# Previews run `ljos`.
find_ljos
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
  dir="$(absolute "$1")"
  shift
else
  # A copy: a person trying Studio edits it, and the sample stays as it is.
  dir="$(own_target)/studio-sample"
  if [ ! -d "$dir" ]; then
    mkdir -p "$(dirname "$dir")"
    cp -R "$studio_root/samples/hello" "$dir"
  fi
  echo "No DIR given: opening a copy of samples/hello in $dir" >&2
fi
exec cargo run --release -q -p studio --bin studio -- "$@" "$dir"
