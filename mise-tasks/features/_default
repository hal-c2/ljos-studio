#!/usr/bin/env bash
#MISE description="Studio's Gherkin scenarios, or only the given feature files or directories"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
# Previews run `ljos`; unless LJOS names one, build it from the Ljós
# checkout beside this one, the same one the path dependencies use.
if [ -z "${LJOS:-}" ]; then
  ljos_ui="$root/../ljos-ui"
  cargo build --manifest-path "$ljos_ui/Cargo.toml" -p ljos_cli --bin ljos
  LJOS="${CARGO_TARGET_DIR:-$ljos_ui/target}/debug/ljos"
fi
export LJOS
# Each runner takes the scenarios that are its own: studio_mcp's speak to
# the tools, studio_blocks' (@ui) drive Studio's window; the wasm build's
# (@web, and the tools' again) are `mise run features:web`. The two here
# both run, so one that fails does not hide what the other says.
failed=0
run() {
  STUDIO_FEATURES="$1" cargo test -p studio_mcp --test features || failed=1
  STUDIO_FEATURES="$1" cargo test -p studio_blocks --test ui || failed=1
}
if [ $# -eq 0 ]; then
  run "$root/features"
  # The server through its stdio front door, with a real preview.
  cargo test -p studio --test stdio -- --ignored || failed=1
else
  for path in "$@"; do
    run "$(realpath "$path")"
  done
fi
exit $failed
