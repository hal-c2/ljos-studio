#!/usr/bin/env bash
#MISE description="Studio's session, tools and web crate build for wasm32 with nothing native in them; clippy, warnings denied"
set -euo pipefail
. "$(dirname "$0")/../_lib/env.sh"
need_rust_parts components
need_rust_parts targets
# `--no-default-features` leaves out the directory store, the timer thread
# and stdio: what is left must stand on its own in a browser.
cargo clippy --target wasm32-unknown-unknown -p studio_core -p studio_mcp -p studio_web \
  --no-default-features -- -D warnings
# Ljós's MCP core without its server half is the protocol alone, so the page
# links no rmcp or tokio and needs no `--cfg tokio_unstable` to build.
if cargo tree -p studio_web --no-default-features -e normal \
    --target wasm32-unknown-unknown | grep -E '\b(rmcp|tokio) '; then
  echo "studio_web for wasm32 links rmcp or tokio" >&2
  exit 1
fi
