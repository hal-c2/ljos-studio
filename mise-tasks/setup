#!/usr/bin/env bash
#MISE description="First run, and again whenever: mise's tools, Rust's components and the wasm target, ljos at the pinned ljos-ui and the pinned wasm-bindgen CLI into the target's tools; with --web, ljos-web beside this checkout. Ends with what it did and what it skipped, and fails when something is still missing"
#USAGE flag "--web" help="Also clone ljos-web at web/ljos-web.rev beside this checkout (when none is there) and install its packages and Playwright's Chromium, for `mise run dev --web` and the browser tasks. An existing checkout is only reported on, never changed"
#USAGE flag "--check" help="Install, clone and build nothing: say what is there and what setup would get, and fail when something is missing (with --web, the browser's needs too)"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib/env.sh
. "$(dirname "$0")/_lib/env.sh"
# The only task that downloads; every other one says to run this instead.
# Each step prints the command it runs, and skips what is already there.
done_list=""
skipped=""
missing=""
# An item's later lines (a command to run, another way) stay under it.
item() { printf '\n  - %s' "$1" | sed '3,$s/^/    /'; }
did() { done_list="$done_list$(item "$1")"; }
skip() { skipped="$skipped$(item "$1")"; }
lack() { missing="$missing$(item "$1")"; }
web="${usage_web:-false}"
check="${usage_check:-false}"

# What the tasks build with. Under `mise run`, activate_aggressive (mise.toml)
# puts the pinned toolchain ahead of a distro Rust; when the rustc found is
# still another one, every build would lack setup's components and target,
# so that is a failure with the fix, not a note.
rust_report() {
  if ! command -v rustup >/dev/null; then
    lack "$(no_rustup)"
    return 0
  fi
  local why parts
  if why="$(wrong_rustc)" && [ -n "$why" ]; then
    lack "Rust: $why, or builds use that Rust, without setup's components and targets"
  else
    did "found $(rustc --version)"
  fi
  parts="$(missing_rust_parts components) $(missing_rust_parts targets)"
  parts="$(printf '%s' "$parts" | tr -s ' ' | sed 's/^ //; s/ $//')"
  if [ -n "$parts" ]; then
    lack "Rust's $parts (rust-toolchain.toml): mise run setup adds them with rustup"
  else
    did "found Rust's $(toolchain_list components | tr -s ' ') and $(toolchain_list targets | tr -s ' ')"
  fi
}

ljos_report() {
  local rev tools
  rev="$(ljos_ui_rev)"
  tools="$(own_target)/tools"
  if [ -n "${LJOS:-}" ]; then
    did "ljos: LJOS is set ($LJOS)"
  elif [ -f "${LJOS_UI:-$studio_root/../ljos-ui}/Cargo.toml" ]; then
    did "ljos: the tasks build it from ${LJOS_UI:-../ljos-ui}"
  elif [ -x "$tools/bin/ljos" ] && [ "$(cat "$tools/ljos.rev" 2>/dev/null || true)" = "$rev" ]; then
    did "found ljos for ljos-ui $rev in $tools"
  else
    lack "ljos for ljos-ui $rev: mise run setup runs $(ljos_install_command)"
  fi
  local said
  if said="$( (find_bindgen && echo "$WASM_BINDGEN") 2>&1)"; then
    did "found wasm-bindgen $(bindgen_version) ($said)"
  else
    lack "$said"
  fi
}

# A report's first line says found or SKIPPED; the lines after it (Qt's
# ways to point at an install) belong to the same item. With --web asked,
# what the browser needs and lacks is missing, not skipped.
web_report() {
  local last="" line
  while IFS= read -r line; do
    case "$line" in
      SKIPPED\ *)
        if [ "$web" = true ]; then lack "${line#SKIPPED }"; last=lack; else skip "${line#SKIPPED }"; last=skip; fi
        ;;
      found\ *) did "$line"; last=did ;;
      "") ;;
      *)
        case "$last" in
          did) done_list="$done_list
      $line" ;;
          lack) missing="$missing
      $line" ;;
          *) skipped="$skipped
      $line" ;;
        esac
        ;;
    esac
  done <<EOF2
$(report_ljos_web || true)
$(if [ -d "$(ljos_web_dir)" ]; then report_qt || true; fi)
EOF2
}

summary() {
  local verb="$1"
  printf '\nsetup %s:%s\n' "$verb" "${done_list:-
  - nothing}"
  if [ -n "$skipped" ]; then
    printf 'setup skipped:%s\n' "$skipped"
  fi
  if [ -n "$missing" ]; then
    printf 'setup is missing:%s\n' "$missing" >&2
    if [ "$check" = true ]; then
      echo "mise run setup$([ "$web" != true ] || echo " --web") gets what it can of these; each line says how to get the rest" >&2
    fi
    exit 1
  fi
  echo
  echo "Next: mise run dev (the native window), or mise run dev --web (in a browser)"
}

if [ "$check" = true ]; then
  for tool in rust node; do
    if at="$(mise where "$tool" 2>/dev/null)"; then
      did "found mise's $tool ($at)"
    else
      lack "mise's $tool (mise.toml): mise run setup runs mise install"
    fi
  done
  rust_report
  ljos_report
  web_report
  summary found
fi

echo "mise install"
mise install
did "mise's tools (mise.toml)"
install_rust_parts
did "Rust's components and targets (rust-toolchain.toml)"
if [ -n "${LJOS:-}" ]; then
  echo "LJOS is set ($LJOS): no ljos to install"
  skip "ljos: LJOS is set ($LJOS)"
elif [ -f "${LJOS_UI:-$studio_root/../ljos-ui}/Cargo.toml" ]; then
  echo "a ljos-ui checkout is beside this one: the tasks build ljos from it"
  skip "ljos: the tasks build it from ${LJOS_UI:-../ljos-ui}"
else
  install_ljos
  did "ljos for ljos-ui $(ljos_ui_rev), in $(own_target)/tools"
fi
install_bindgen
did "wasm-bindgen $(bindgen_version), in $(own_target)/tools"

if [ "$web" = true ] && [ ! -e "$(ljos_web_dir)" ]; then
  clone_ljos_web
  did "ljos-web at $ljos_web_pin in $(physical "$(ljos_web_dir)"), with its packages and Playwright's Chromium"
fi
# Asked again after installing, so the summary says what is true now.
rust_ok="$(wrong_rustc || true)"
[ -z "$rust_ok" ] || lack "Rust: $rust_ok, or builds use that Rust, without setup's components and targets"
web_report
summary did
