#!/usr/bin/env bash
#MISE description="Build Studio for the web: studio_web as wasm and its JavaScript glue, into web/pkg"
set -euo pipefail
. "$(dirname "$0")/../_lib/env.sh"
if ! [ -d "$(rustc --print sysroot)/lib/rustlib/wasm32-unknown-unknown" ]; then
  die "This Rust has no wasm32 target: run rustup target add wasm32-unknown-unknown"
fi
# The glue must come from the CLI of the version the crate links; found
# before the build, so a missing one costs no compile.
find_bindgen
cargo build --target wasm32-unknown-unknown -p studio_web --profile web
# `--target web` is an ES module a page imports and node can start from
# the bytes (`initSync`), so one build serves the browser and the runner.
"$WASM_BINDGEN" --target web --out-dir "$studio_root/web/pkg" \
  "$(own_target)/wasm32-unknown-unknown/web/studio_web.wasm"
