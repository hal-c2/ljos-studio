#!/usr/bin/env bash
#MISE description="Studio on the web for you to open: builds the page and serves it on the loopback interface (PORT, default 5199)"
#MISE depends=["web:build"]
#USAGE flag "--port <port>" env="PORT" default="5199" help="The port to serve on"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../../_lib/env.sh
. "$(dirname "$0")/../../_lib/env.sh"
build_served_page
exec node "$studio_root/web/serve.mjs" "$app" "${usage_port:-${PORT:-5199}}"
