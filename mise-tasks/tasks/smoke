#!/usr/bin/env bash
#MISE description="Run every mise task in a quick, non-interactive mode, so a broken task turns CI red"
#USAGE flag "--list" help="Print the table of tasks and how each is smoke-tested, and run nothing"
#USAGE flag "--only <task>" help="Smoke-test this one task"
#USAGE flag "--dry" help="Dry-run every task, the ones the table runs too: what a machine that builds nothing checks (CI's macOS job)"
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

# task | mode | arguments | why it is only a dry run
#   run: a real, quick, non-interactive run of `mise run <task> <arguments>`
#   dry: `mise run -n <task> <arguments>` (usage and depends resolve) and bash -n
# Both with --skip-tools: mise's tools come from setup, so a missing one is
# the task's failure to say so, not a download mise does on its behalf.
# @tmp@ in the arguments is a scratch directory removed at the end. Adding
# or removing a task without changing this table fails the smoke test.
# tasks:smoke tests only its own --list, so it never recurses. In CI it runs
# after setup, check, test and features:web, and reuses what they built.
table() {
  cat <<'EOF_TABLE'
setup|run|--check|
check|dry||CI runs it in full as its own step, before this
check:tasks|run||
check:wasm|dry||mise run check runs it, and CI runs check as its own step
check:web-modules|dry||needs an ljos-web checkout beside this one; CI's browser job runs it
build|dry||a release build of studio is minutes long; CI's test step builds the same code
dev|dry||opens a window and runs until it is closed; driven off-screen by hand
docs|run||
export:web:build|dry|@tmp@/bundle|needs an exported bundle and ljos-web; export:web:check runs it in CI's browser job
export:web:check|dry||needs ljos-web and Playwright's Chromium; CI's browser job runs it
features|run|features/ui/picture_document.feature|
features:browser|dry||needs ljos-web and Playwright's Chromium; CI's browser job runs it
features:web|dry||CI runs it in full as its own step, before this
fmt|run|--check|
install|run|--dry-run --with-ljos --root @tmp@/install|
measure-lookup|dry||asks the qml6 of the machine it runs on, which CI does not have; run it with --check where Qt 6 is
measure-members|dry||asks the qml6 of the machine it runs on, which CI does not have; run it with --check where Qt 6 is
perf|dry|samples/hello|a release build, and timings that want a quiet machine
tasks:smoke|run|--list|
test|dry||CI runs it in full as its own step, before this
web:bench|run||
web:browser|dry||needs ljos-web's Playwright and Chromium; CI's browser job runs it
web:build|run||
web:serve|dry||serves until it is stopped; web:serve:check drives it in CI's browser job
web:serve:check|dry||needs ljos-web's Playwright and Chromium; CI's browser job runs it
web:serve:test|run||
web:shell|dry||needs ljos-web, its qmlc, Qt 6's QML and Chromium; CI's browser job runs it
EOF_TABLE
}

if [ "${usage_list:-}" = true ]; then
  printf '%-18s %-4s %-45s %s\n' TASK MODE ARGUMENTS "WHY DRY"
  table | while IFS='|' read -r task mode args why; do
    printf '%-18s %-4s %-45s %s\n' "$task" "$mode" "${args:--}" "$why"
  done
  exit 0
fi
only="${usage_only:-}"
all_dry="${usage_dry:-false}"

# The tasks this repo defines, as "name<TAB>source"; mise also lists any
# global tasks, which are not this repo's to test.
command -v python3 >/dev/null || { echo "tasks:smoke: python3 is not on PATH; it reads mise tasks --json" >&2; exit 1; }
tasks="$(mise tasks --json | python3 -I -c '
import json, sys
root = sys.argv[1].rstrip("/") + "/"
for t in json.load(sys.stdin):
    if t["source"].startswith(root):
        print(t["name"] + "\t" + t["source"])
' "$root")"
[ -n "$tasks" ] || { echo "tasks:smoke: mise lists no tasks from $root" >&2; exit 1; }
names="$(printf '%s\n' "$tasks" | cut -f1 | sort)"
tabled="$(table | cut -d'|' -f1 | sort)"

failed=0
results=""
record() {
  results="$results$(printf '%-18s %-6s %-6s %-8s %s' "$1" "$2" "$3" "$4" "${5:-}")
"
  [ "$3" = ok ] || failed=1
}

for t in $(comm -23 <(printf '%s\n' "$names") <(printf '%s\n' "$tabled")); do
  echo "tasks:smoke: task '$t' has no entry in the table in mise-tasks/tasks/smoke; add one" >&2
  record "$t" "-" FAIL 0
done
for t in $(comm -13 <(printf '%s\n' "$names") <(printf '%s\n' "$tabled")); do
  echo "tasks:smoke: the table names '$t', which is no longer a task; remove it" >&2
  record "$t" "-" FAIL 0
done

# Every task file, whether or not --only picks it, and what they share. A
# file with a #MISE header that mise does not list is one it cannot run.
lint=""
problem() {
  echo "tasks:smoke: $1:$2" >&2
  lint=1
}
listed="$(printf '%s\n' "$tasks" | cut -f2)"
for f in $(find mise-tasks -type f | sort); do
  problems=""
  case "$f" in
    *.py)
      python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f" 2>/dev/null ||
        problem "$f" " python3 cannot parse it;"
      continue
      ;;
    mise-tasks/_lib/*) ;;
    *)
      grep -q '^#MISE ' "$f" || continue
      printf '%s\n' "$listed" | grep -qxF "$root/$f" ||
        problems="$problems mise does not list it (is it executable?);"
      grep -q '^#MISE description=' "$f" || problems="$problems no #MISE description;"
      grep -q '^set -euo pipefail' "$f" || problems="$problems no 'set -euo pipefail';"
      ;;
  esac
  bash -n "$f" 2>/dev/null || problems="$problems bash -n fails;"
  if command -v shellcheck >/dev/null 2>&1 && ! shellcheck -x -S warning "$f" >/dev/null 2>&1; then
    problems="$problems shellcheck -S warning fails (run: shellcheck -x -S warning $f);"
  fi
  [ -z "$problems" ] || problem "$f" "$problems"
done
if ! command -v shellcheck >/dev/null 2>&1; then
  echo "tasks:smoke: shellcheck is not on PATH, so the tasks are not linted with it: install it (pacman -S shellcheck, apt install shellcheck, brew install shellcheck)" >&2
  lint=1
fi
if [ -z "$lint" ]; then
  record "(static)" lint ok 0
else
  record "(static)" lint FAIL 0
fi

# Off-screen: a smoke run never opens a window.
unset WAYLAND_DISPLAY DISPLAY SWAYSOCK HYPRLAND_INSTANCE_SIGNATURE
scratch="$(mktemp -d "${TMPDIR:-/tmp}/studio-smoke.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

found_only=""
while IFS='|' read -r task mode args why; do
  [ -z "$only" ] || [ "$only" = "$task" ] || continue
  found_only=1
  source="$(printf '%s\n' "$tasks" | awk -F'\t' -v t="$task" '$1 == t { print $2 }')"
  [ -n "$source" ] || continue
  # Split as words first, then @tmp@ filled in each, so a scratch path
  # with a space stays one argument.
  raw=()
  words=()
  read -r -a raw <<<"$args" || true
  for word in ${raw[@]+"${raw[@]}"}; do
    words+=("${word//@tmp@/$scratch}")
  done
  args="${args//@tmp@/$scratch}"
  note=""
  if [ "$mode" = dry ] && [ -z "$why" ]; then
    echo "tasks:smoke: '$task' is a dry run with no reason given" >&2
    record "$task" "$mode" FAIL 0
    continue
  fi
  if [ "$all_dry" = true ] && [ "$mode" = run ]; then
    mode=dry
    note="--dry"
  fi
  echo "== tasks:smoke: $mode $task $args${note:+ ($note)}"
  start="$(date +%s)"
  result=ok
  # ${words[@]+…}: bash 3.2 calls an empty array unset under set -u.
  case "$mode" in
    run) mise run --skip-tools "$task" ${words[@]+"${words[@]}"} </dev/null || result=FAIL ;;
    dry) { mise run --skip-tools -n "$task" ${words[@]+"${words[@]}"} </dev/null && bash -n "$source"; } || result=FAIL ;;
    *) echo "tasks:smoke: '$task' has unknown mode '$mode'" >&2; result=FAIL ;;
  esac
  record "$task" "$mode" "$result" "$(($(date +%s) - start))" "$note"
done < <(table)
if [ -n "$only" ] && [ -z "$found_only" ]; then
  echo "tasks:smoke: --only '$only' is not in the table" >&2
  exit 1
fi

echo
printf '%-18s %-6s %-6s %-8s %s\n' TASK MODE RESULT SECONDS NOTE
printf '%s' "$results"
exit "$failed"
