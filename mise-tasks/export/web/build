#!/usr/bin/env bash
#MISE description="A site from a Studio web export (build/web), built as Studio builds it, by an ljos-web checkout, into BUNDLE-site or OUT"
#USAGE arg "<bundle>" help="A directory the tool export wrote with target web (it holds ljos-site.json)"
#USAGE arg "[out]" help="Where the site goes; default BUNDLE-site. A site Studio built there is replaced"
set -euo pipefail
# Studio's own site builder (web/site/build.mjs, which Studio carries in
# itself), run from this checkout: ljos-web compiles and bundles the files
# the manifest lists. It downloads nothing: it needs an ljos-web checkout
# with its packages installed and its qmlc.
# shellcheck source-path=SCRIPTDIR source=../../_lib/env.sh
. "$(dirname "$0")/../../_lib/env.sh"
bundle="$(absolute "${usage_bundle:?}")"
[ -f "$bundle/ljos-site.json" ] || die "$bundle holds no ljos-site.json: export with \"target\": \"web\" first"
out="${usage_out:-$bundle-site}"
case "$out" in
  /*) ;;
  *) out="${MISE_ORIGINAL_CWD:-$PWD}/$out" ;;
esac

find_ljos_web
find_qmlc
find_design_qml
work="$(own_target)/export-web"
rm -rf "$work"
mkdir -p "$work/node_modules/@solidjs" "$work/standins"
cp "$studio_root"/web/site/{build.mjs,index.html,main.js,vite.config.js} "$work/"
cp -R "$LJOS_DESIGN/Ljos" "$work/standins/"
modules="$LJOS_WEB/examples/web/node_modules"
for module in ljos-web solid-js vite @solidjs/web; do
  ln -s "$(physical "$modules/$module")" "$work/node_modules/$module"
done
pinned="$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).ljos_web)' "$bundle/ljos-site.json")"
at="$(git -C "$LJOS_WEB" rev-parse HEAD 2>/dev/null || true)"
case "$at" in
  "" | "$pinned") ;;
  *) echo "note: the bundle was checked against ljos-web $pinned; building with $at" >&2 ;;
esac
export LJOS_QT_TYPES="${LJOS_QT_TYPES:-$LJOS_WEB/crates/ljos_web/types.txt}"
node "$work/build.mjs" "$bundle" "$out"
